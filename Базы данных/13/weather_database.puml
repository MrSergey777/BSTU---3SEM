@startuml Weather Database Logical Schema
left to right direction
!theme plain
skinparam linetype ortho
skinparam ranksep 80
skinparam nodesep 80
skinparam packageStyle rectangle
skinparam entityIconSize 0
hide circle

' Таблица пользователей
entity Users {
  --
  **PK** : id : UUID
  --
  username : VARCHAR(50)
  email : VARCHAR(150)
  password_hash : VARCHAR(255)
  is_active : BOOLEAN
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

note right of Users
  UK: username
  UK: email
end note

' Таблица провайдеров API
entity ApiProviders {
  --
  **PK** : id : UUID
  --
  name : VARCHAR(100)
  base_url : VARCHAR(255)
  api_key_masked : VARCHAR(120)
  contact : VARCHAR(120)
}

' Таблица локаций
entity Locations {
  --
  **PK** : id : UUID
  --
  **FK** : provider_id : UUID (nullable)
  --
  name : VARCHAR(120)
  country : VARCHAR(80)
  region : VARCHAR(120)
  latitude : DOUBLE PRECISION
  longitude : DOUBLE PRECISION
  created_at : TIMESTAMPTZ
}

' Таблица данных о погоде (кэш)
entity WeatherData {
  --
  **PK** : id : UUID
  --
  **FK** : location_id : UUID
  **FK** : source_provider_id : UUID (nullable)
  --
  data_type : VARCHAR(30)
  payload : JSONB
  fetched_at : TIMESTAMPTZ
  expires_at : TIMESTAMPTZ
}

note right of WeatherData
  UK: location_id, data_type, fetched_at
end note

' Таблица избранных локаций
entity Favorites {
  --
  **PK** : id : UUID
  --
  **FK** : user_id : UUID
  **FK** : location_id : UUID
  --
  label : VARCHAR(120)
  position : INT
  created_at : TIMESTAMPTZ
}

note right of Favorites
  UK: user_id, location_id
end note

' Таблица уведомлений
entity Notifications {
  --
  **PK** : id : UUID
  --
  **FK** : user_id : UUID
  **FK** : location_id : UUID (nullable)
  --
  type : VARCHAR(50)
  threshold : NUMERIC(10,2)
  channel : VARCHAR(50)
  enabled : BOOLEAN
  schedule : JSONB
  last_sent_at : TIMESTAMPTZ
  created_at : TIMESTAMPTZ
}

' Таблица логов уведомлений
entity NotificationLogs {
  --
  **PK** : id : UUID
  --
  **FK** : notification_id : UUID
  **FK** : user_id : UUID
  --
  status : VARCHAR(30)
  sent_at : TIMESTAMPTZ
  channel : VARCHAR(50)
  details : TEXT
}

' Таблица истории запросов
entity RequestsHistory {
  --
  **PK** : id : UUID
  --
  **FK** : user_id : UUID (nullable)
  **FK** : location_id : UUID (nullable)
  --
  query_text : TEXT
  requested_at : TIMESTAMPTZ
  client_ip : INET
}

' Раскладка: две горизонтальные строки
' Верхний ряд
Users -[hidden]right- Favorites
Favorites -[hidden]right- Notifications
Notifications -[hidden]right- NotificationLogs

' Нижний ряд
ApiProviders -[hidden]right- Locations
Locations -[hidden]right- WeatherData
WeatherData -[hidden]right- RequestsHistory

' Выравнивание по колонкам
Users -[hidden]down- ApiProviders
Favorites -[hidden]down- Locations
Notifications -[hidden]down- WeatherData
NotificationLogs -[hidden]down- RequestsHistory

' Связи между таблицами
ApiProviders::id ||-right-o{ Locations::provider_id
ApiProviders::id ||-right-o{ WeatherData::source_provider_id

Locations::id ||-right-o{ WeatherData::location_id
Locations::id ||-up-o{ Favorites::location_id
Locations::id ||-up-o{ Notifications::location_id
Locations::id ||-right-o{ RequestsHistory::location_id

Users::id ||-right-o{ Favorites::user_id
Users::id ||-right-o{ Notifications::user_id
Users::id ||-right-o{ NotificationLogs::user_id
Users::id ||-down-o{ RequestsHistory::user_id

Notifications::id ||-right-o{ NotificationLogs::notification_id

@enduml

@startuml Weather Service Use Cases
left to right direction
!theme plain
skinparam linetype ortho
skinparam packageStyle rectangle
allowmixing

actor "Гость" as Guest

rectangle "Веб-сервис Погода" {
  usecase "Просмотр суточного прогноза" as UC_Daily
  usecase "Поиск населённого пункта" as UC_Search
  usecase "Просмотр почасового прогноза" as UC_Hourly
  usecase "Просмотр справочной информации" as UC_Info
}

Guest -- UC_Daily
Guest -- UC_Search
Guest -- UC_Hourly
Guest -- UC_Info

@enduml

@startuml Weather Database Physical Schema
left to right direction
!theme plain
skinparam linetype ortho
skinparam ranksep 80
skinparam nodesep 80
skinparam packageStyle rectangle
skinparam entityIconSize 0
hide circle

entity ApiProviders {
  --
  **PK** : id : INT
  --
  name : VARCHAR(100)
  base_url : VARCHAR(255)
  api_key_masked : VARCHAR(100)
  contact : VARCHAR(100)
